---
// ExternalContactForm.astro
// Embeds the HighLevel CRM form widget for lead capture
---

<section class="external-form-section py-16 bg-gradient-to-b from-white to-gray-50">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto">
      <div class="bg-white rounded-lg shadow-lg p-4 md:p-8">
        <div id="highlevel-form-container">
          <iframe
            src="https://link.thethaiger.com/widget/form/g8FW8pSqrg4MJ9iwp7tV"
            style="width:100%;height:800px;border:none;border-radius:4px"
            id="inline-g8FW8pSqrg4MJ9iwp7tV"
            data-layout="{'id':'INLINE'}"
            data-trigger-type="alwaysShow"
            data-trigger-value=""
            data-activation-type="alwaysActivated"
            data-activation-value=""
            data-deactivation-type="neverDeactivate"
            data-deactivation-value=""
            data-form-name="Contact Form"
            data-height="800"
            data-layout-iframe-id="inline-g8FW8pSqrg4MJ9iwp7tV"
            data-form-id="g8FW8pSqrg4MJ9iwp7tV"
            title="Contact Form"
            loading="lazy"
          ></iframe>
          <script src="https://link.thethaiger.com/js/form_embed.js" is:inline></script>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Ensure minimum height for form container */
  #highlevel-form-container {
    min-height: 600px;
  }

  /* Adjust iframe height for mobile devices */
  @media (max-width: 768px) {
    #highlevel-form-container iframe {
      height: 900px !important;
    }
  }
</style>
