---
import Layout from '@/layouts/Layout.astro';
import StoneDetail from '@/components/StoneDetail';
import { getStoneBySlug, stoneData } from '@/data/stoneData';

export async function getStaticPaths() {
  const paths = stoneData.map((stone) => ({
    params: { 
      slug: `${stone.category}/${stone.slug}` 
    },
    props: { stone },
  }));
  
  console.log('Generated static paths:', paths.length, 'total paths');
  return paths;
}

const { stone } = Astro.props;

console.log('Stone detail page - stone prop:', stone ? `${stone.name} (${stone.category})` : 'MISSING!');

if (!stone) {
  console.error('No stone found in props, redirecting to products');
  return Astro.redirect('/products');
}

const title = `${stone.name} - ${stone.category === 'granite' ? 'Granite' : 'Marble'} - BMG`;
const description = stone.description;

// Product structured data with offers
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": `https://bmgstone.com/products/${stone.category}/${stone.slug}`,
  "name": stone.name,
  "description": stone.description,
  "image": stone.image.src,
  "brand": {
    "@type": "Brand",
    "name": "BMG"
  },
  "category": stone.category === 'granite' ? 'Granite' : 'Marble',
  "material": stone.category === 'granite' ? 'Granite' : 'Marble',
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "THB",
    "priceSpecification": {
      "@type": "PriceSpecification",
      "price": "0",
      "priceCurrency": "THB",
      "valueAddedTaxIncluded": true
    },
    "availability": "https://schema.org/InStock",
    "availableDeliveryMethod": "https://schema.org/OnSitePickup",
    "seller": {
      "@type": "Organization",
      "@id": "https://bmgstone.com/#organization",
      "name": "BMG Stone",
      "url": "https://bmgstone.com"
    },
    "priceValidUntil": new Date(new Date().setFullYear(new Date().getFullYear() + 1)).toISOString().split('T')[0],
    "url": `https://bmgstone.com/products/${stone.category}/${stone.slug}`,
    "itemCondition": "https://schema.org/NewCondition",
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": 30,
      "returnMethod": "https://schema.org/ReturnByMail",
      "returnFees": "https://schema.org/FreeReturn"
    }
  },
  "additionalProperty": [
    {
      "@type": "PropertyValue", 
      "name": "Colors",
      "value": stone.colors?.join(", ") || "Various"
    },
    {
      "@type": "PropertyValue",
      "name": "Applications",
      "value": stone.applications?.join(", ") || "Flooring, Countertops, Wall Cladding"
    }
  ]
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)}></script>
  <main class="stone-detail-page">
    <StoneDetail stone={stone} client:load />
  </main>
</Layout>

<style>
  .stone-detail-page {
    min-height: 100vh;
  }
</style>