---
import Layout from '../layouts/Layout.astro';
import PolicyComponent from '../components/Policy.tsx';

// SEO data for policy page
const title = "Privacy Policy - BMG Bangkok Modern Granite | นโยบายความเป็นส่วนตัว";
const description = "Privacy Notice and Data Protection Policy for BMG Bangkok Modern Granite Co., Ltd. Learn about how we collect, use, and protect your personal information. | คำประกาศเกี่ยวกับการคุ้มครองข้อมูลส่วนบุคคลของบริษัท บางกอกโมเดอร์นแกรนิต จำกัด";
const image = `${Astro.url.origin}/favicon.svg`;

// Policy Page Schema
const policyPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Privacy Policy",
  "description": "Privacy Notice and Data Protection Policy for BMG Bangkok Modern Granite",
  "url": `${Astro.url.origin}/policy`,
  "isPartOf": {
    "@id": `${Astro.url.origin}/#website`
  },
  "about": {
    "@type": "Thing",
    "name": "Personal Data Protection",
    "description": "BMG's commitment to protecting personal data in accordance with Thailand's Personal Data Protection Act (PDPA) B.E. 2562"
  },
  "datePublished": "2022-05-31",
  "dateModified": "2022-05-31",
  "publisher": {
    "@type": "Organization",
    "@id": `${Astro.url.origin}/#organization`,
    "name": "Bangkok Modern Granite Co., Ltd."
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": Astro.url.origin
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Privacy Policy",
        "item": `${Astro.url.origin}/policy`
      }
    ]
  }
};
---

<Layout title={title} description={description} image={image}>
  <script type="application/ld+json" set:html={JSON.stringify(policyPageSchema)}></script>
  <PolicyComponent client:load />
</Layout>